# Node
node_modules/
*.log

# 本地缓存（留在工作区内，不入库）
.npm-cache/
.electron-cache/
.electron-builder-cache/

# 构建产物
desktop-electron/dist/
desktop-shell/dist/

# vendor/profile 由 build-host.mjs 构建期生成
desktop-electron/vendor/profile/
# DSH 更新按钮的临时暂存树（放在 vendor 同级是为了保证换树 rename 同卷；不是产物，不入库）
desktop-electron/vendor/staging/

# 签名私钥与证书（永不入库）
desktop-electron/scripts/certs/
*.pfx

# 冒烟隔离 home（boot-smoke / 壳冒烟测试产物，.dsh-m0/m1a/... 任意后缀）
.dsh-m*/
.dsh-pkg*/
.dshell-data/
.dsh-pkg-out.log
.dsh-pkg-err.log

# 编辑器
.vscode/
.idea/

# 会话临时诊断（DSH 工具产生，不入库）
.dsh-inspect/

# 背景图探针输出
desktop-electron/scripts/bg-probe*-out.json
.dsh-smoke-*/
